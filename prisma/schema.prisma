// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  vehicles  Vehicle[]
  sessions  Session[]
}

model Vehicle {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  make      String?
  model     String?
  year      Int?
  fuel      String?
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  createdAt DateTime @default(now())
  severity  String
  summary   String
  symptoms  Symptom[]
  insights  Insight[]
}

model Symptom {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  key       String  // e.g. "light", "smoke", "start", "noise", "temp"
  value     String  // e.g. "EPC", "white", "no-crank"
}

model Insight {
  id          String  @id @default(cuid())
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label       String  // cause name
  why         String
  confidence  Float
  steps       Json    // string[]
}
